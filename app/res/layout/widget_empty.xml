<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
    <ImageView android:id="@+id/widget_empty_icon" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_done" android:tint="#1265D6" android:background="@drawable/widget_count_background" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:text="都取完啦" android:textSize="16sp" android:textStyle="bold" android:textColor="#08263C"/>
    <TextView android:id="@+id/widget_empty_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:text="轻松出门" android:textSize="12sp" android:textColor="#657789"/>
    <TextView android:id="@+id/widget_empty_link" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:text="打开拾件簿 ›" android:textSize="11sp" android:textColor="#1265D6"/>
</LinearLayout>
